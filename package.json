{
  "name": "iig-uops-bridge",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:build": "python3 scripts/build_data.py",
    "data:update": "python3 scripts/download_data.py && npm run data:build",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "npm run build && vitest run",
    "test:browser": "npm run build && playwright test",
    "check": "npm run build && vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
